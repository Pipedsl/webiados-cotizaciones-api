# --- Database (Railway Postgres plugin inyecta DATABASE_URL / PG* automaticamente) ---
# Para local con docker:  docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cotizaciones postgres:16
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cotizaciones
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- JWT ---
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-de-al-menos-64-caracteres-aqui
JWT_ADMIN_TTL=480
JWT_CLIENT_TTL=30

# --- Admin bootstrap (se siembra al primer arranque, luego se ignora) ---
ADMIN_BOOTSTRAP_EMAIL=felipe@webiados.com
ADMIN_BOOTSTRAP_PASSWORD=cambia-esta-clave

# --- Email (SMTP). Recomendado: Resend (smtp.resend.com:465) o Brevo (smtp-relay.brevo.com:587) ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxx
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=cotizaciones@webiados.com
NOTIFY_TO=contacto@webiados.com

# --- Negocio ---
QUOTE_VALIDITY_DAYS=15
# Base de la landing que ve el cliente (la sirve el frontend Angular).
QUOTE_PUBLIC_BASE_URL=https://webiados.com/cotizacion

# --- CORS ---
# OJO: cotiza.webiados.com NO existe (NXDOMAIN). El frontend vive en webiados.com.
CORS_ALLOWED_ORIGINS=https://webiados.com,https://www.webiados.com,http://localhost:4200
